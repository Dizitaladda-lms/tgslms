# ==========================================
# TSG LMS Backend Environment Configuration
# ==========================================

# Port & Environment
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# JWT Secret (Mandatory in production for security)
JWT_SECRET=your_super_strong_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=https://tsg-ecru.vercel.app,https://www.nidads.com,https://www.nigape.com,https://dizitaladda.com

# ==========================================
# Redis Cache Configuration (For 10k+ Users Scaling)
# Optional: If not provided, backend automatically falls back to High-Performance In-Memory Cache.
# ==========================================
REDIS_URL=redis://default:your_redis_password@your-redis-host:6379
# Alternatively:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_TWPxFYGnxRpKCL
RAZORPAY_SECRET=mAMXyMCSTkWmTfT8UaQgHxpK

# OpenAI Key (For AI Student Mentor)
OPENAI_API_KEY=sk-...

# Cloudinary Credentials (For Lecture uploads)
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret
